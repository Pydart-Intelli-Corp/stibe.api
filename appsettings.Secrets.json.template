{
  "_comment": "This is a template file. Copy this to appsettings.Secrets.json and fill in your actual secret values.",
  "_warning": "NEVER commit the actual appsettings.Secrets.json file to version control!",
  
  "ConnectionStrings": {
    "DefaultConnection": "Server=your_server;Port=3306;UserID=your_user;Password=your_password;Database=your_database;SslMode=Required;SslCa=config/certificates/DigiCertGlobalRootCA.crt.pem"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-jwt-key-that-should-be-at-least-64-characters-long-for-security"
  },
  "GoogleOAuth": {
    "ClientId": "your-google-client-id.apps.googleusercontent.com",
    "ClientSecret": "your-google-client-secret",
    "AndroidClientId": "your-android-client-id.apps.googleusercontent.com",
    "WebClientId": "your-web-client-id.apps.googleusercontent.com"
  },
  "FileStorage": {
    "Azure": {
      "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net",
      "ContainerSasToken": "your_sas_token"
    }
  },
  "SmtpSettings": {
    "Username": "your_smtp_username",
    "Password": "your_smtp_password",
    "SenderEmail": "your_sender_email@domain.com"
  },
  "Razorpay": {
    "KeyId": "your_razorpay_key_id",
    "KeySecret": "your_razorpay_key_secret",
    "WebhookSecret": "your_razorpay_webhook_secret"
  }
}