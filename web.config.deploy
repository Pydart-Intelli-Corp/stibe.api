<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <modules>
      <remove name="DefaultDocumentModule" />
      <remove name="DirectoryListingModule" />
      <remove name="StaticFileModule" />
      <remove name="AnonymousAuthenticationModule" />
    </modules>
    <defaultDocument>
      <files>
        <clear />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".*" />
    </staticContent>
    <handlers>
      <clear />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModule" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\stibe.api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />
  </system.webServer>
</configuration>