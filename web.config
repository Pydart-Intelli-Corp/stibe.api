<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Configure request limits for file uploads -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="52428800" /> <!-- 50MB -->
        </requestFiltering>
      </security>
      
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      
      <aspNetCore processPath="dotnet" 
                  arguments=".\stibe.api.dll" 
                  stdoutLogEnabled="true" 
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ASPNETCORE_URLS" value="http://+:80" />
          <environmentVariable name="ASPNETCORE_CONTENTROOT" value="." />
        </environmentVariables>
      </aspNetCore>
      
      <!-- Static file handling for uploads -->
      <staticContent>
        <mimeMap fileExtension=".jpg" mimeType="image/jpeg" />
        <mimeMap fileExtension=".jpeg" mimeType="image/jpeg" />
        <mimeMap fileExtension=".png" mimeType="image/png" />
      </staticContent>
      
      <!-- Directory browsing for uploads folder -->
      <directoryBrowse enabled="false" />
    </system.webServer>
  </location>
  
  <!-- ASP.NET Core request limits -->
  <system.web>
    <httpRuntime maxRequestLength="51200" /> <!-- 50MB in KB -->
  </system.web>
</configuration>
