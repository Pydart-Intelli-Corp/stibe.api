# .gitignore
# Secrets and sensitive configuration
config/secrets/
*.key
*.pem
*.p12
*.pfx

# Environment specific files (if they contain secrets)
config/environments/*.local.json

# Logs
logs/
*.log

# Build results
bin/
obj/
publish/

# Visual Studio
.vs/
.vscode/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Entity Framework migrations (if sensitive)
# Uncomment if migrations contain sensitive data
# src/Infrastructure/Data/Migrations/