###
# Test Google OAuth Configuration
# Before running these tests, make sure:
# 1. The API is running (dotnet run)
# 2. You have a valid Google ID token from the Flutter app

### Test API Health
GET http://localhost:5074/api/health
Accept: application/json

### Test Google Login Endpoint
POST http://localhost:5074/api/auth/google-login
Content-Type: application/json

{
  "googleToken": "YOUR_GOOGLE_ID_TOKEN_HERE",
  "role": "SalonOwner",
  "acceptTerms": true
}

### Test Google Register Endpoint
POST http://localhost:5074/api/auth/google-register
Content-Type: application/json

{
  "googleToken": "YOUR_GOOGLE_ID_TOKEN_HERE", 
  "role": "SalonOwner",
  "acceptTerms": true
}

### Test Google OAuth Settings (Debug endpoint if available)
GET http://localhost:5074/api/auth/google-debug
Accept: application/json

###
# Notes:
# - Replace YOUR_GOOGLE_ID_TOKEN_HERE with actual Google ID token from Flutter app
# - The token expires quickly (typically 1 hour), so get fresh tokens for testing
# - Role can be "Customer" or "SalonOwner"
# - acceptTerms should be true for new registrations
